---
import Layout from '../../../layouts/Layout.astro'
import TopNav from '../../../components/TopNav.astro'
import Footer from '../../../components/Footer.astro'

interface Chapter {
  num: number
  title?: string
}

interface Meta {
  title: string
  author: string
  synopsis: string
  totalChapters: number
  chapters: Chapter[]
}

const { slug } = Astro.params as { slug: string }

// URL-based pagination — ?page=N
const pageParam = Astro.url.searchParams.get('page')
const page = Math.max(1, parseInt(pageParam || '1', 10) || 1)
const PAGE_SIZE = 50

let meta: Meta | null = null
try {
  const res = await fetch(new URL(`/${slug}.json`, Astro.url))
  if (res.ok) meta = await res.json()
} catch {
  // meta stays null
}

const chapters = meta?.chapters ?? []
const total = chapters.length
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE))
const safePage = Math.min(page, totalPages)
const pagedChapters = chapters.slice((safePage - 1) * PAGE_SIZE, safePage * PAGE_SIZE)
const latestChap = chapters[total - 1]
const pageTitle = meta ? meta.title : 'Truyện'
---

<Layout title={meta ? `${meta.title} — Truyện` : 'Truyện'}>
  <TopNav title={meta?.title} />
  <main class="flex-1 max-w-300 mx-auto w-full px-4 md:px-8 pb-24">
    {
      !meta ? (
        <p class="py-24 text-sm text-muted">Không tìm thấy truyện.</p>
      ) : (
        <>
          <div class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-10 md:gap-14 py-14 md:py-24 items-start">
            <div class="bg-primary rounded-xl aspect-2/3 max-w-35 md:max-w-none flex items-center justify-center relative overflow-hidden">
              <div class="absolute inset-0 bg-linear-to-br from-white/12 to-black/15" />
              <span class="relative text-[48px] text-white/60 leading-none">✦</span>
            </div>
            <div class="flex flex-col gap-4 md:pt-4">
              <div class="flex flex-wrap gap-2">
                <span class="badge">{meta.author}</span>
                <span class="badge">{total} chương</span>
              </div>
              <h1 class="font-display text-[32px] md:text-[48px] tracking-[-1px] text-ink leading-[1.08]">
                {meta.title}
              </h1>
              <p class="text-base text-body leading-[1.7] max-w-150">{meta.synopsis}</p>

              <!-- Action buttons: default is "Đọc từ đầu"; client script upgrades to "Đọc tiếp" if progress exists -->
              <div
                id="story-actions"
                class="flex flex-wrap gap-3 mt-2"
                data-slug={slug}
                data-first={chapters[0]?.num}
                data-latest={latestChap?.num}
              >
                <a href={`/truyen/${slug}/chuong/${chapters[0]?.num}`} class="btn-primary" id="btn-read-start">
                  Đọc từ đầu
                </a>
                {latestChap && (
                  <a href={`/truyen/${slug}/chuong/${latestChap.num}`} class="btn-secondary">
                    Mới nhất · Ch.{latestChap.num}
                  </a>
                )}
              </div>
            </div>
          </div>

          <section class="border-t border-hairline pt-8">
            <h2 class="section-label">Danh sách chương</h2>

            {totalPages > 1 && (
              <div class="flex items-center gap-2 flex-wrap mb-4">
                {safePage > 1 ? (
                  <a href={`?page=${safePage - 1}`} class="btn-secondary text-xs px-3 py-1.5">
                    ← Trước
                  </a>
                ) : (
                  <span class="btn-secondary text-xs px-3 py-1.5 opacity-35 cursor-default">← Trước</span>
                )}
                {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
                  <a
                    href={`?page=${p}`}
                    class={`text-xs px-3 py-1.5 rounded-md transition-colors ${p === safePage ? 'bg-primary text-white' : 'bg-surface-soft text-body hover:bg-surface-card'}`}
                  >
                    {p}
                  </a>
                ))}
                {safePage < totalPages ? (
                  <a href={`?page=${safePage + 1}`} class="btn-secondary text-xs px-3 py-1.5">
                    Sau →
                  </a>
                ) : (
                  <span class="btn-secondary text-xs px-3 py-1.5 opacity-35 cursor-default">Sau →</span>
                )}
              </div>
            )}

            <div class="flex flex-col gap-0.5" id="chapter-list">
              {pagedChapters.map((c) => (
                <a
                  href={`/truyen/${slug}/chuong/${c.num}`}
                  class="chapter-link flex items-center gap-3 px-4 py-3 rounded-md transition-colors text-body hover:bg-surface-soft"
                  data-num={c.num}
                >
                  <span class="chapter-num text-sm font-medium w-20 shrink-0 text-muted">
                    Chương {c.num}
                  </span>
                  {c.title && (
                    <span class="text-[15px] text-body-strong">{c.title}</span>
                  )}
                  <span class="progress-dot w-2 h-2 bg-primary rounded-full ml-auto shrink-0 hidden" aria-label="Đang đọc" />
                </a>
              ))}
            </div>

            {totalPages > 1 && (
              <div class="flex items-center gap-2 flex-wrap mt-4">
                {safePage > 1 ? (
                  <a href={`?page=${safePage - 1}`} class="btn-secondary text-xs px-3 py-1.5">
                    ← Trước
                  </a>
                ) : (
                  <span class="btn-secondary text-xs px-3 py-1.5 opacity-35 cursor-default">← Trước</span>
                )}
                {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
                  <a
                    href={`?page=${p}`}
                    class={`text-xs px-3 py-1.5 rounded-md transition-colors ${p === safePage ? 'bg-primary text-white' : 'bg-surface-soft text-body hover:bg-surface-card'}`}
                  >
                    {p}
                  </a>
                ))}
                {safePage < totalPages ? (
                  <a href={`?page=${safePage + 1}`} class="btn-secondary text-xs px-3 py-1.5">
                    Sau →
                  </a>
                ) : (
                  <span class="btn-secondary text-xs px-3 py-1.5 opacity-35 cursor-default">Sau →</span>
                )}
              </div>
            )}
          </section>
        </>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  import { getProgress } from '../../../scripts/readingProgress.js'

  const actions = document.getElementById('story-actions') as HTMLElement | null
  const slug = actions?.dataset.slug
  if (!slug) { /* no-op — story actions element not found */ }
  else {
  const progress = getProgress(slug)

  if (progress?.chapter) {
    // Upgrade "Đọc từ đầu" to "Đọc tiếp"
    const btnStart = document.getElementById('btn-read-start') as HTMLAnchorElement | null
    if (btnStart) {
      btnStart.href = `/truyen/${slug}/chuong/${progress.chapter}`
      btnStart.textContent = `Đọc tiếp · Ch.${progress.chapter}`
    }
    // Insert "Đọc từ đầu" as secondary next to existing latest button
    const firstNum = actions?.dataset.first
    if (firstNum && actions) {
      const fromStart = document.createElement('a')
      fromStart.href = `/truyen/${slug}/chuong/${firstNum}`
      fromStart.className = 'btn-secondary'
      fromStart.textContent = 'Đọc từ đầu'
      // Insert after primary button (index 1)
      const children = actions.children
      if (children.length >= 1) {
        actions.insertBefore(fromStart, children[1])
      } else {
        actions.appendChild(fromStart)
      }
    }

    // Highlight current chapter in chapter list
    const currentChapter = progress.chapter
    document.querySelectorAll<HTMLAnchorElement>('.chapter-link').forEach((link) => {
      if (Number(link.dataset.num) === currentChapter) {
        link.classList.remove('text-body', 'hover:bg-surface-soft')
        link.classList.add('bg-surface-card', 'text-ink')
        const numSpan = link.querySelector('.chapter-num')
        numSpan?.classList.remove('text-muted')
        numSpan?.classList.add('text-primary')
        link.querySelector('.progress-dot')?.classList.remove('hidden')
      }
    })
  }
  } // end else(slug)
</script>
