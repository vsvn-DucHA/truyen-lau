---
import '../styles/global.css'
---

<!doctype html>
<html lang='vi'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Đăng nhập · Truyện</title>
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Merriweather:ital,wght@0,400;0,700;1,400&family=Lora:ital,wght@0,400;0,500;1,400&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;1,7..72,400&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400&display=swap'
      rel='stylesheet'
    />
    <script is:inline>
      ;(function () {
        try {
          var s = JSON.parse(
            localStorage.getItem('truyen_reading_settings') || '{}',
          )
          if (s.darkMode) document.documentElement.classList.add('dark')
          var fontMap = {
            merriweather: "'Merriweather', serif",
            lora: "'Lora', serif",
            literata: "'Literata', serif",
            georgia: 'Georgia, serif',
            inter: "'Inter', sans-serif",
            mono: "'JetBrains Mono', monospace",
          }
          var font = fontMap[s.fontId] || "'EB Garamond', serif"
          document.documentElement.style.setProperty('--reading-font', font)
          document.documentElement.style.setProperty(
            '--reading-size',
            (s.fontSize || 20) + 'px',
          )
        } catch (e) {}
      })()
    </script>
  </head>
  <body class='min-h-screen bg-canvas flex items-center justify-center px-4'>
    <div class='w-full max-w-sm'>
      <!-- Logo -->
      <div class='text-center mb-8'>
        <a href='/' class='inline-flex items-center gap-2 justify-center'>
          <span class='text-primary text-2xl leading-none'>✦</span>
          <span class='font-body text-xl font-medium text-ink'>Truyện</span>
        </a>
        <p class='mt-3 text-sm text-muted'>Nhập API key để truy cập</p>
      </div>

      <!-- Card -->
      <div
        class='bg-surface-card border border-hairline rounded-2xl p-8 shadow-sm'
      >
        <form id='login-form' novalidate>
          <div class='mb-5'>
            <label
              for='api-key-input'
              class='block text-sm font-medium text-ink mb-2'
            >
              API Key
            </label>
            <input
              id='api-key-input'
              type='password'
              autocomplete='off'
              spellcheck='false'
              placeholder='Dán API key vào đây...'
              class='w-full px-4 py-3 rounded-lg border border-hairline
                bg-canvas text-ink text-sm font-mono
                placeholder:text-muted-soft
                focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20
                transition-colors'
            />
          </div>

          <!-- Error message -->
          <div
            id='error-msg'
            class='hidden mb-4 px-4 py-3 rounded-lg bg-error/10 border border-error/30 text-error text-sm'
          >
          </div>

          <button
            id='login-btn'
            type='submit'
            class='w-full py-3 rounded-lg bg-primary text-on-primary
              text-sm font-medium font-body
              hover:bg-primary-active active:scale-[.98]
              disabled:opacity-50 disabled:cursor-not-allowed disabled:pointer-events-none
              transition-all duration-150
              flex items-center justify-center gap-2'
          >
            <span id='btn-text'>Đăng nhập</span>
            <svg
              id='btn-spinner'
              class='hidden animate-spin'
              width='16'
              height='16'
              viewBox='0 0 24 24'
              fill='none'
              aria-hidden='true'
            >
              <circle
                cx='12'
                cy='12'
                r='10'
                stroke='currentColor'
                stroke-width='3'
                stroke-dasharray='60'
                stroke-dashoffset='20'
                stroke-linecap='round'></circle>
            </svg>
          </button>
        </form>
      </div>

      <p class='text-center text-xs text-muted mt-6'>
        Key được cấp qua Discord. Liên hệ admin nếu chưa có key.
      </p>
    </div>

    <script>
      import { login, isAuthenticated } from '../scripts/auth.js'

      // Redirect if already logged in
      if (isAuthenticated()) {
        const redirect =
          new URLSearchParams(location.search).get('redirect') || '/'
        location.replace(redirect)
      }

      const form = document.getElementById('login-form')!
      const input = document.getElementById('api-key-input')!
      const btn = document.getElementById('login-btn')!
      const btnText = document.getElementById('btn-text')!
      const spinner = document.getElementById('btn-spinner')!
      const errMsg = document.getElementById('error-msg')!

      function setLoading(on) {
        btn.disabled = on
        btnText.textContent = on ? 'Đang xác thực...' : 'Đăng nhập'
        spinner.classList.toggle('hidden', !on)
      }

      function showError(msg) {
        errMsg.textContent = msg
        errMsg.classList.remove('hidden')
        input.classList.add(
          'border-error',
          'focus:border-error',
          'focus:ring-error/20',
        )
      }

      function clearError() {
        errMsg.classList.add('hidden')
        errMsg.textContent = ''
        input.classList.remove(
          'border-error',
          'focus:border-error',
          'focus:ring-error/20',
        )
      }

      input.addEventListener('input', clearError)

      form.addEventListener('submit', async (e) => {
        e.preventDefault()
        const key = input.value.trim()
        if (!key) {
          showError('Vui lòng nhập API key.')
          input.focus()
          return
        }

        clearError()
        setLoading(true)

        const result = await login(key)

        setLoading(false)

        if (!result.ok) {
          showError(result.message)
          input.focus()
          return
        }

        const redirect =
          new URLSearchParams(location.search).get('redirect') || '/'
        location.replace(redirect)
      })
    </script>
  </body>
</html>
