---
interface Props {
  /** Page title shown in the nav bar (middle text) */
  title?: string
  /**
   * When set, the title becomes a link back to the story page.
   * Used on ChapterPage.
   */
  storySlug?: string
  /** When true, the settings gear icon is shown (ChapterPage only) */
  showSettingsBtn?: boolean
}

const { title, storySlug, showSettingsBtn = false } = Astro.props
---

<nav
  class='sticky top-0 z-100 bg-canvas border-b border-hairline h-16 flex items-center px-4 md:px-8 gap-6'
>
  <a href='/' class='flex items-center gap-1.5 shrink-0'>
    <span class='text-primary text-lg leading-none'>✦</span>
    <span class='font-body text-sm font-medium text-ink'>Truyện</span>
  </a>

  {
    title && storySlug ? (
      <a
        href={`/truyen/${storySlug}`}
        class='font-body text-sm text-muted overflow-hidden whitespace-nowrap text-ellipsis flex-1 min-w-0 hidden sm:block hover:text-ink transition-colors'
      >
        {title}
      </a>
    ) : title ? (
      <span class='font-body text-sm text-muted overflow-hidden whitespace-nowrap text-ellipsis flex-1 min-w-0 hidden sm:block'>
        {title}
      </span>
    ) : null
  }

  <div class='ml-auto flex items-center gap-2 shrink-0'>
    <!-- Dark mode toggle -->
    <button
      id='btn-dark-mode'
      class='w-9 h-9 rounded-pill border border-hairline flex items-center justify-center transition-colors bg-canvas text-muted hover:bg-surface-card hover:text-ink hover:border-primary'
      aria-label='Chuyển chế độ sáng/tối'
      title='Chuyển chế độ sáng/tối'
    >
      <!-- Icon swapped by client script based on current mode -->
      <svg
        id='icon-moon'
        width='18'
        height='18'
        viewBox='0 0 20 20'
        fill='none'
        aria-hidden='true'
      >
        <path
          d='M17 13A8 8 0 1 1 7 3a6 6 0 0 0 10 10z'
          stroke='currentColor'
          stroke-width='1.5'
          stroke-linejoin='round'></path>
      </svg>
      <svg
        id='icon-sun'
        width='18'
        height='18'
        viewBox='0 0 20 20'
        fill='none'
        aria-hidden='true'
        style='display:none'
      >
        <circle cx='10' cy='10' r='3.5' stroke='currentColor' stroke-width='1.5'
        ></circle>
        <path
          d='M10 2v1.5M10 16.5V18M2 10h1.5M16.5 10H18M4.343 4.343l1.06 1.06M14.597 14.597l1.06 1.06M4.343 15.657l1.06-1.06M14.597 5.403l1.06-1.06'
          stroke='currentColor'
          stroke-width='1.5'
          stroke-linecap='round'></path>
      </svg>
    </button>

    {
      showSettingsBtn && (
        <button
          id='btn-settings-toggle'
          class='w-9 h-9 rounded-pill border border-hairline bg-canvas text-muted flex items-center justify-center transition-colors hover:bg-surface-card hover:text-ink hover:border-primary'
          aria-label='Cài đặt đọc'
          title='Cài đặt font chữ'
          data-settings-active='false'
        >
          <svg
            width='20'
            height='20'
            viewBox='0 0 20 20'
            fill='none'
            aria-hidden='true'
          >
            <circle
              cx='10'
              cy='10'
              r='2.5'
              stroke='currentColor'
              stroke-width='1.5'
            />
            <svg
              xmlns='http://www.w3.org/2000/svg'
              width='24'
              height='24'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
            >
              <path d='M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2v-2a2 2 0 0 1 2-2h.343' />
              <path d='M12 4v.343' />
              <path d='m17 3 4 4-9 9-4-4Z' />
              <path d='m21 8-4-4' />
            </svg>
          </svg>
        </button>
      )
    }
  </div>
</nav>

<script>
  import { toggleDarkMode, getSettings } from '../scripts/readingSettings.js'

  // Sync icon with current dark mode state on load
  function syncDarkIcon() {
    const { darkMode } = getSettings()
    const moon = document.getElementById('icon-moon')
    const sun = document.getElementById('icon-sun')
    if (moon) moon.style.display = darkMode ? 'none' : ''
    if (sun) sun.style.display = darkMode ? '' : 'none'
  }
  syncDarkIcon()

  document.getElementById('btn-dark-mode')?.addEventListener('click', () => {
    toggleDarkMode()
    syncDarkIcon()
  })

  // Settings panel toggle
  const settingsBtn = document.getElementById('btn-settings-toggle')
  settingsBtn?.addEventListener('click', () => {
    const isActive = settingsBtn.dataset.settingsActive === 'true'
    settingsBtn.dataset.settingsActive = String(!isActive)
    // Toggle button appearance
    settingsBtn.classList.toggle('bg-surface-card', !isActive)
    settingsBtn.classList.toggle('text-ink', !isActive)
    settingsBtn.classList.toggle('border-primary', !isActive)
    settingsBtn.classList.toggle('bg-canvas', isActive)
    settingsBtn.classList.toggle('text-muted', isActive)
    settingsBtn.classList.toggle('border-hairline', isActive)
    document.dispatchEvent(new CustomEvent('settings:toggle'))
  })
</script>
