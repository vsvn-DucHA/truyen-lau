---
interface Props {
  /** Page title shown in the nav bar (middle text) */
  title?: string
  /**
   * When set, the title becomes a link back to the story page.
   * Used on ChapterPage.
   */
  storySlug?: string
  /** When true, the settings gear icon is shown (ChapterPage only) */
  showSettingsBtn?: boolean
  /** When true, the story editor icon is shown (ChapterPage only) */
  showStoryEditorBtn?: boolean
}

const {
  title,
  storySlug,
  showSettingsBtn = false,
  showStoryEditorBtn = false,
} = Astro.props
---

<nav
  id='top-nav'
  class='fixed inset-x-0 top-0 z-100 bg-canvas border-b border-hairline h-16 flex items-center px-4 md:px-8 gap-6 translate-y-0 transition-transform duration-300 ease-out will-change-transform'
>
  <a href='/' class='flex items-center gap-1.5 shrink-0'>
    <span class='text-primary text-lg leading-none'>✦</span>
    <span class='font-body text-sm font-medium text-ink'>Truyện</span>
  </a>

  {
    title && storySlug ? (
      <a
        href={`/truyen/${storySlug}`}
        class='font-body text-sm text-muted overflow-hidden whitespace-nowrap text-ellipsis flex-1 min-w-0 hidden sm:block hover:text-ink transition-colors'
      >
        {title}
      </a>
    ) : title ? (
      <span class='font-body text-sm text-muted overflow-hidden whitespace-nowrap text-ellipsis flex-1 min-w-0 hidden sm:block'>
        {title}
      </span>
    ) : null
  }

  <div class='ml-auto flex items-center gap-2 shrink-0'>
    <!-- Dark mode toggle -->
    <button
      id='btn-dark-mode'
      class='w-9 h-9 rounded-pill border border-hairline flex items-center justify-center transition-colors bg-canvas text-muted hover:bg-surface-card hover:text-ink hover:border-primary'
      aria-label='Chuyển chế độ sáng/tối'
      title='Chuyển chế độ sáng/tối'
    >
      <!-- Icon swapped by client script based on current mode -->
      <svg
        id='icon-moon'
        width='18'
        height='18'
        viewBox='0 0 20 20'
        fill='none'
        aria-hidden='true'
      >
        <path
          d='M17 13A8 8 0 1 1 7 3a6 6 0 0 0 10 10z'
          stroke='currentColor'
          stroke-width='1.5'
          stroke-linejoin='round'></path>
      </svg>
      <svg
        id='icon-sun'
        width='18'
        height='18'
        viewBox='0 0 20 20'
        fill='none'
        aria-hidden='true'
        style='display:none'
      >
        <circle cx='10' cy='10' r='3.5' stroke='currentColor' stroke-width='1.5'
        ></circle>
        <path
          d='M10 2v1.5M10 16.5V18M2 10h1.5M16.5 10H18M4.343 4.343l1.06 1.06M14.597 14.597l1.06 1.06M4.343 15.657l1.06-1.06M14.597 5.403l1.06-1.06'
          stroke='currentColor'
          stroke-width='1.5'
          stroke-linecap='round'></path>
      </svg>
    </button>

    {
      showStoryEditorBtn && (
        <button
          id='btn-story-editor-toggle'
          class='w-9 h-9 rounded-pill border border-hairline bg-canvas text-muted flex items-center justify-center transition-colors hover:bg-surface-card hover:text-ink hover:border-primary'
          aria-label='Chỉnh sửa truyện'
          title='Chỉnh sửa truyện'
          data-story-editor-active='false'
        >
          <svg
            width='20'
            height='20'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
            aria-hidden='true'
          >
            <path d='M12 20h9' />
            <path d='M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z' />
          </svg>
        </button>
      )
    }

    {
      showSettingsBtn && (
        <button
          id='btn-settings-toggle'
          class='w-9 h-9 rounded-pill border border-hairline bg-canvas text-muted flex items-center justify-center transition-colors hover:bg-surface-card hover:text-ink hover:border-primary'
          aria-label='Cài đặt đọc'
          title='Cài đặt font chữ'
          data-settings-active='false'
        >
          <svg
            width='20'
            height='20'
            viewBox='0 0 20 20'
            fill='none'
            aria-hidden='true'
          >
            <circle
              cx='10'
              cy='10'
              r='2.5'
              stroke='currentColor'
              stroke-width='1.5'
            />
            <svg
              xmlns='http://www.w3.org/2000/svg'
              width='24'
              height='24'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
            >
              <path d='M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2v-2a2 2 0 0 1 2-2h.343' />
              <path d='M12 4v.343' />
              <path d='m17 3 4 4-9 9-4-4Z' />
              <path d='m21 8-4-4' />
            </svg>
          </svg>
        </button>
      )
    }
  </div>
</nav>
<div class='h-16 shrink-0' aria-hidden='true'></div>

<script>
  import { toggleDarkMode, getSettings } from '../scripts/readingSettings.js'

  // Sync icon with current dark mode state on load
  function syncDarkIcon() {
    const { darkMode } = getSettings()
    const moon = document.getElementById('icon-moon')
    const sun = document.getElementById('icon-sun')
    if (moon) moon.style.display = darkMode ? 'none' : ''
    if (sun) sun.style.display = darkMode ? '' : 'none'
  }
  syncDarkIcon()

  document.getElementById('btn-dark-mode')?.addEventListener('click', () => {
    toggleDarkMode()
    syncDarkIcon()
  })

  function setToggleState(
    button: HTMLElement | null,
    datasetKey: string,
    isActive: boolean,
  ) {
    if (!button) return
    button.dataset[datasetKey] = String(isActive)
    button.classList.toggle('bg-surface-card', isActive)
    button.classList.toggle('text-ink', isActive)
    button.classList.toggle('border-primary', isActive)
    button.classList.toggle('bg-canvas', !isActive)
    button.classList.toggle('text-muted', !isActive)
    button.classList.toggle('border-hairline', !isActive)
  }

  // Story editor panel toggle
  const storyEditorBtn = document.getElementById('btn-story-editor-toggle')
  storyEditorBtn?.addEventListener('click', () => {
    const isActive = storyEditorBtn.dataset.storyEditorActive === 'true'
    setToggleState(storyEditorBtn, 'storyEditorActive', !isActive)
    document.dispatchEvent(new CustomEvent('story-editor:toggle'))
  })

  document.addEventListener('story-editor:closed', () => {
    setToggleState(storyEditorBtn, 'storyEditorActive', false)
  })

  // Settings panel toggle
  const settingsBtn = document.getElementById('btn-settings-toggle')
  settingsBtn?.addEventListener('click', () => {
    const isActive = settingsBtn.dataset.settingsActive === 'true'
    setToggleState(settingsBtn, 'settingsActive', !isActive)
    document.dispatchEvent(new CustomEvent('settings:toggle'))
  })

  document.addEventListener('settings:closed', () => {
    setToggleState(settingsBtn, 'settingsActive', false)
  })

  const topNav = document.getElementById('top-nav')
  let lastScrollY = window.scrollY
  let ticking = false
  let keepVisible = false

  function showNav() {
    if (!topNav) return
    topNav.classList.remove('-translate-y-full')
    topNav.classList.add('translate-y-0')
  }

  function hideNav() {
    if (!topNav) return
    topNav.classList.remove('translate-y-0')
    topNav.classList.add('-translate-y-full')
  }

  function syncNavVisibility() {
    if (!topNav) return
    const currentScrollY = window.scrollY
    const delta = currentScrollY - lastScrollY
    const shouldHide = currentScrollY > 96 && delta > 8 && !keepVisible
    const shouldShow = delta < -8 || currentScrollY <= 32 || keepVisible

    if (shouldHide) {
      hideNav()
    } else if (shouldShow) {
      showNav()
    }

    lastScrollY = currentScrollY
    ticking = false
  }

  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return
      ticking = true
      window.requestAnimationFrame(syncNavVisibility)
    },
    { passive: true },
  )

  document.addEventListener('story-editor:toggle', () => {
    keepVisible = true
    showNav()
  })

  document.addEventListener('story-editor:closed', () => {
    keepVisible = false
  })

  document.addEventListener('settings:toggle', () => {
    keepVisible = true
    showNav()
  })

  document.addEventListener('settings:closed', () => {
    keepVisible = false
  })
</script>
